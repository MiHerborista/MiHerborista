# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------
# FUTURE INTEGRATIONS (Activate by providing valid credentials)
# -----------------------------------------------------------------

# DATABASE (PostgreSQL / Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/miherborista?sslmode=disable"

# AUTHENTICATION (Clerk Auth)
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# BACKGROUND JOBS & EVENT WORKFLOWS (Inngest)
INNGEST_EVENT_KEY="ink_..."
INNGEST_SIGNING_KEY="signkey_..."

